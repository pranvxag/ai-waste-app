# Copy this file to .env and fill in real values. Never commit .env.

# Reuse ideas (Groq) + their YouTube tutorial links. Without these the app still
# scans and shows disposal guidance; the reuse sections just show an empty state.
GROQ_API_KEY=
YOUTUBE_API_KEY=

# Gemini Vision - the fallback that identifies items YOLO isn't confident about.
# Without this, low-confidence scans return "couldn't identify" instead.
GEMINI_API_KEY=

# Optional. Minimum YOLO detection confidence to trust without asking Gemini.
YOLO_CONFIDENCE_THRESHOLD=0.70

# Optional. Comma-separated Expo web origins. Defaults to * for current behavior.
CORS_ORIGINS=*

# Optional. Maximum uploaded image size in bytes.
MAX_UPLOAD_BYTES=10485760

# Optional. Gemini model override.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Path to YOLO weights - set this to plug in a custom waste-trained
# model. Defaults to backend/model/yolov8n.pt.
YOLO_MODEL_PATH=
